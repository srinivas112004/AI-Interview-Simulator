# ==========================================
# AI Interview Simulator - .gitignore
# ==========================================

# --- Virtual Environments (Python) ---
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/

# --- Python Cache & Bytecode ---
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Node & Frontend Builds ---
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
frontend/dist/
dist-ssr/
.vite/
frontend/.vite/

# --- Environment & Sensitive Credentials ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key

# --- Database & Local Storage ---
*.db
*.db-journal
*.db.backup
*.sqlite
*.sqlite3
interview_sim.db
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# --- Testing & Code Coverage ---
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.cache/

# --- Scratch Scripts & Temporary Files ---
scratch/
tmp/
temp/
*.tmp
*.bak
*.swp
*~

# --- Operating System & IDE Files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Logs ---
*.log
logs/
*.log.*
